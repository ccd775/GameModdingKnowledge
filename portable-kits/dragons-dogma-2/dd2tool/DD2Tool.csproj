<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <!-- RE-Engine-Lib checkout (kagenocookie/RE-Engine-Lib, commit bf0e5e5222700716516797613a54b9b61fedfc35).
         Default: a folder named RE-Engine-Lib next to this one; override with -p:ReeLibDir=<path>. -->
    <ReeLibDir Condition="'$(ReeLibDir)' == ''">$(MSBuildThisFileDirectory)..\RE-Engine-Lib</ReeLibDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ReeLibDir)\REE-Lib\REE-Lib.csproj" />
    <ProjectReference Include="$(ReeLibDir)\REE-Lib.Generators\REE-Lib.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
