<Project Sdk="Microsoft.NET.Sdk">
  <!-- portable kit: dotnet build -c Release -p:SwitchToolboxDir=<Switch Toolbox folder> -o <copy of that folder> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Toolbox.Library"><HintPath>$(SwitchToolboxDir)\Toolbox.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FirstPlugin.Plg"><HintPath>$(SwitchToolboxDir)\FirstPlugin.Plg.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bfres"><HintPath>$(SwitchToolboxDir)\Syroot.NintenTools.NSW.Bfres.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Syroot.NintenTools.Bfres"><HintPath>$(SwitchToolboxDir)\Syroot.NintenTools.Bfres.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Syroot.BinaryData"><HintPath>$(SwitchToolboxDir)\Syroot.BinaryData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Syroot.Maths"><HintPath>$(SwitchToolboxDir)\Syroot.Maths.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OpenTK"><HintPath>$(SwitchToolboxDir)\Lib\OpenTK.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SwitchToolboxDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
